{
  "name": "obsidian-better-export",
  "version": "2.0.3",
  "description": "Export Obsidian notes to PDF, DOCX, HTML, Markdown, text and RTF with multilingual settings and customizable footer annotations.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "dev:vite": "vite build --watch --mode development",
    "build:vite": "pnpm check && vite build",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "test": "node scripts/test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "package": "pnpm check && pnpm test && pnpm build && node scripts/package.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^20.14.10",
    "builtin-modules": "3.3.0",
    "electron": "39.8.3",
    "esbuild": "0.28.0",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^8.57.0",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.13",
    "obsidian": "^1.12.3",
    "playwright": "^1.63.0",
    "svelte": "^5.56.2",
    "svelte-check": "^4.6.0",
    "svelte-preprocess": "^6.0.3",
    "tslib": "2.6.3",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.1.3"
  },
  "dependencies": {
    "docx": "^9.8.1",
    "p-limit": "^7.3.0",
    "pagedjs": "0.4.3",
    "pdf-lib": "^1.17.1"
  },
  "obsidian": {
    "id": "better-export",
    "name": "Better Export",
    "version": "2.0.3",
    "minAppVersion": "0.15.0",
    "description": "Export notes to PDF, DOCX, HTML, Markdown, text and RTF with previews and customizable footer annotations.",
    "author": "l1xnan",
    "authorUrl": "https://github.com/l1xnan",
    "fundingUrl": "https://www.buymeacoffee.com/l1xnan",
    "isDesktopOnly": true
  }
}
